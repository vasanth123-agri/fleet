# Fleet Monitoring Frontend Environment Configuration

# Backend API Base URL
# Option 1: When using Nginx reverse proxy on same domain / subpath (Default):
VITE_API_BASE_URL=/api

# Option 2: When backend runs on a dedicated domain/port in production:
# VITE_API_BASE_URL=https://api-fleet.yourdomain.com/api

# Option 3: Local development without Vite proxy:
# VITE_API_BASE_URL=http://localhost:5050/api

# Application Title
VITE_APP_TITLE=AgriInverse Fleet
