  updatedAt       DateTime              @updatedAt
  ruleName        String
  syncedToNodeRed Boolean               @default(false)
  nodeRedSyncedAt DateTime?
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggers        AutomationTrigger[]
  actions         AutomationAction[]
  executions      AutomationExecution[]

  @@unique([userId, ruleName])
  @@index([userId])
  @@index([farmId])
  @@index([isActive])
  @@index([syncedToNodeRed])
}

model AutomationTrigger {
  id                 String                @id @default(cuid())
  ruleId             String
  triggerPoint       String
  lowerThreshold     Float?
  upperThreshold     Float?
  comparisonOperator String?
  createdAt          DateTime              @default(now())
  triggerType        String
  unit               String?
  timerOption        String? // "Stopwatch" or "Timer"
  targetTime         String? // For Timer mode - e.g. "14:30"
  runFor             String? // For Stopwatch mode - e.g. "30 Mins"
  startCondition     String? // e.g. "Immediately"
  gap                String? // e.g. "5 Mins"
  repeatOption       String? // e.g. "Once", "Daily"
  endCondition       String? // e.g. "Run once"
  updatedAt          DateTime              @updatedAt
  rule               AutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actions            AutomationAction[]
  executions         AutomationExecution[]

  @@index([ruleId])
}

