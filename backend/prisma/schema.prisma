  category   String?  // "fertigation" | "sensor" | "system" | "automation" | "telemetry"
  title      String
  message    String   @db.Text
  details    String?  @db.Text
  metadata   Json?    // Structured JSON metadata (e.g. { sensor: "phA", pt: 1, ok: true })

  status     String?  @default("completed") // "completed" | "failed" | "pending"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm     Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  boundary farmBoundary? @relation(fields: [boundaryId], references: [id], onDelete: SetNull)

  @@index([userId, farmId, timestamp(sort: Desc)])
  @@index([type])
  @@index([category])
  @@index([timestamp])
  @@map("outdoor_logs")
