# Fleet Monitoring Backend Deployment Environment Configuration

# Server Port
PORT=5050

# Runtime Environment (production / development)
NODE_ENV=production

# Database Connection URLs (PostgreSQL - AgriInverse Database)
# Pooled connection string (e.g. via Supabase / PgBouncer / RDS Proxy)
DATABASE_URL="postgresql://username:password@host:6543/postgres?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=30&pgbouncer=true"

# Direct connection string for Prisma migrations / direct access
DIRECT_URL="postgresql://username:password@host:5432/postgres?sslmode=require&connect_timeout=30"

# Sensor Reading Status Thresholds (in minutes)
READING_LIVE_THRESHOLD_MINUTES=15
READING_RECENT_THRESHOLD_MINUTES=60

# Allowed CORS Origins (comma-separated URLs)
CORS_ORIGIN="https://fleet.yourdomain.com,http://localhost:5173"

# Application Timezone
TIMEZONE=Asia/Kolkata
